# HSGQ OLT API - Environment Configuration
# Copy this file to .env and fill in your values

# SNMP Target (wajib)
SNMP_HOST=
SNMP_PORT=
SNMP_COMMUNITY=

# Port Aplikasi (default: 8080)
SERVER_PORT=8080

# Refresh interval (default: 5m)
# REFRESH_INTERVAL=5m

# Redis (optional, untuk caching)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=1
# REDIS_KEY_PREFIX=olt1
